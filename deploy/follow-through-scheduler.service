[Unit]
Description=Follow Through reminder scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eddiedude
WorkingDirectory=/home/eddiedude/follow-through
EnvironmentFile=/home/eddiedude/follow-through/.env
ExecStart=/home/eddiedude/follow-through/.venv/bin/python -m follow_through.scheduler
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
